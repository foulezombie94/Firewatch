{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/vite"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "s-maxage=120, stale-while-revalidate=300"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
